create table tb_compra(
id_compra serial,
cd_usuario integer not null,
cd_produtos varchar(255) not null,
cd_status varchar(255) not null,
nr_valor numeric(18,2) not null,
dt_datacompra date not null,

constraint fk_usuario
foreign key (cd_usuario)
references tb_usuario(id_usuario),

constraint ck_valor_minimo
check (nr_valor >= 0),

constraint ck_data_futuro
check (dt_datacompra <= current_date)
);

