
select 
	tb_aluno.tx_nome,
	tb_curso.tx_nome ,
	tb_nota.vl_nota_1,
	tb_nota.vl_nota_2,
	tb_nota.vl_nota_3
from 
	tb_aluno
inner join tb_curso on
	tb_aluno.cd_curso =
	tb_curso.id_curso
inner join tb_matricula on 
	tb_matricula.cd_aluno =
	tb_aluno.id_aluno
	inner join tb_nota on
	tb_nota.cd_matricula  =
	tb_matricula.id_matricula
where 
    (
	(tb_nota.vl_nota_1 >= 9
	and tb_nota.vl_nota_2 > 8)
	or tb_nota.vl_nota_1 < 7)
	
	
	select * from tb_curso 
		where
		(
		(tb_curso.id_curso
		and tb_curso.tx_nome) 
		or tb_curso.nr_duracao_meses )
			
	