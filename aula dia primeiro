select
tx_nome
from tb_cliente
where upper(tx_nome) like upper('A%')
and tx_nome like 'o%';


	
with vendamaior as (
select
max(dt_venda) as maior,
cd_cliente
from
tb_venda
where upper(tx_status) = upper('PAGO')
group by cd_cliente
)
select
*
from
tb_venda
inner join vendamaior
on vendamaior.cd_cliente = tb_venda.cd_cliente
and tb_venda.dt_venda >= vendamaior.maior

select 
	tp.id_produto,
	AVG(tp.nr_estoque)
from tb_produto tp


with media_estoque AS (
    select
        cd_categoria,
        avg(nr_estoque) AS media_categoria
    from tb_produto
    group by cd_categoria
)
select
    p.tx_nome as tx_produto,
    c.tx_nome as tx_categoria,
    p.nr_estoque as nr_estoque_atual,
    me.media_categoria,
    me.media_categoria - p.nr_estoque as nr_diferenca
from tb_produto p
inner join tb_categoria c
    on c.id_categoria = p.cd_categoria
inner join media_estoque me
    on me.cd_categoria = p.cd_categoria
where p.nr_estoque < me.media_categoria

	


